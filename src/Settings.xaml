<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="18" Width="360" CornerRadius="22" Padding="22,18,22,18" BorderThickness="1"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.Foreground="White">
  <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF232328" Offset="0"/>
      <GradientStop Color="#FF141417" Offset="1"/>
    </LinearGradientBrush>
  </Border.Background>
  <Border.BorderBrush>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#40FFFFFF" Offset="0"/>
      <GradientStop Color="#10FFFFFF" Offset="0.5"/>
      <GradientStop Color="#26FFFFFF" Offset="1"/>
    </LinearGradientBrush>
  </Border.BorderBrush>
  <Border.Effect>
    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
  </Border.Effect>
  <Border.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <Border x:Name="track" Grid.Column="1" Width="40" Height="24" CornerRadius="12" Background="#33FFFFFF">
                <Ellipse x:Name="knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#FF30D158"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="White"/>
                <Setter TargetName="track" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FillRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="White"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EmptyRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,2,0,8"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource FillRepeat}"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource EmptyRepeat}"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Ellipse Width="18" Height="18" Fill="White"/></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#80FFFFFF"/>
      <Setter Property="Margin" Value="0,16,0,4"/>
    </Style>
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="#1FFFFFFF" CornerRadius="15" Padding="14,6" MinWidth="30" MinHeight="30">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Background" Value="#4DFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Border.Resources>

  <StackPanel>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="30" Height="11" CornerRadius="5.5" Background="Black" BorderBrush="#66FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>
        <TextBlock Text="Dynamic Island" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="CloseBtn" Style="{StaticResource Pill}" HorizontalAlignment="Right" Padding="0" ToolTip="Close (Esc)"
              Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
    </Grid>

    <TextBlock Text="GENERAL" Style="{StaticResource Section}"/>
    <CheckBox x:Name="Startup" Content="Launch at startup"/>
    <CheckBox x:Name="HoverExpand" Content="Expand on hover"/>
    <CheckBox x:Name="HideFullscreen" Content="Hide during fullscreen games &amp; video"/>

    <TextBlock Text="APPEARANCE" Style="{StaticResource Section}"/>
    <CheckBox x:Name="Blur" Content="Liquid Glass blur"/>
    <TextBlock x:Name="TintLabel" FontSize="13.5" Margin="0,8,0,0"/>
    <Slider x:Name="Tint" Minimum="0" Maximum="100"/>
    <TextBlock x:Name="OffsetLabel" FontSize="13.5"/>
    <Slider x:Name="Offset" Minimum="0" Maximum="40"/>

    <TextBlock Text="LIVE ACTIVITIES" Style="{StaticResource Section}"/>
    <CheckBox x:Name="Notifications" Content="Show Windows notifications"/>
    <TextBlock x:Name="NotifHint" TextWrapping="Wrap" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,0,50,4"
               Text="Windows is blocking notification access. Allow it in Settings › Privacy &amp; security › Notifications, then restart the app."/>
    <CheckBox x:Name="MediaToasts" Content="Now Playing alerts"/>

    <Grid Margin="0,18,0,0">
      <TextBlock x:Name="Version" FontSize="11.5" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
      <Button x:Name="QuitBtn" Style="{StaticResource Pill}" HorizontalAlignment="Right" Content="Quit Dynamic Island" FontSize="12.5"/>
    </Grid>
  </StackPanel>
</Border>
