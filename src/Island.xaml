<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="#00FFFFFF" CornerRadius="19" RenderTransformOrigin="0.5,0.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#1FFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                <Setter TargetName="bg" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.88" ScaleY="0.88"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand">
    <!-- tinted glass body (alpha comes from settings) -->
    <Border x:Name="Glass"/>
    <!-- specular highlight along the top edge -->
    <Border x:Name="Specular" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#2EFFFFFF" Offset="0"/>
          <GradientStop Color="#0DFFFFFF" Offset="0.32"/>
          <GradientStop Color="#00FFFFFF" Offset="0.55"/>
          <GradientStop Color="#00FFFFFF" Offset="0.85"/>
          <GradientStop Color="#0CFFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Canvas x:Name="Stage" ClipToBounds="True">
      <Rectangle x:Name="Sheen" Width="140" IsHitTestVisible="False" Opacity="0">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#1CFFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.RenderTransform><TranslateTransform x:Name="SheenX"/></Rectangle.RenderTransform>
      </Rectangle>

      <!-- COMPACT: clock / art on the left, battery / equalizer on the right -->
      <Grid x:Name="Compact" Height="34">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border x:Name="CArt" Width="22" Height="22" CornerRadius="6" Margin="-6,0,8,0" Visibility="Collapsed"/>
          <TextBlock x:Name="CTime" Foreground="White" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
          <StackPanel x:Name="Eq" Orientation="Horizontal" VerticalAlignment="Center" Height="14" Visibility="Collapsed">
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,0.5"/>
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,0.5"/>
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,0.5"/>
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,0.5"/>
          </StackPanel>
          <Border x:Name="CBattHost" VerticalAlignment="Center"/>
          <TextBlock x:Name="CDate" Foreground="#B3FFFFFF" FontSize="12.5" VerticalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- EXPANDED, no media: big clock -->
      <Grid x:Name="ExpClock">
        <Grid Margin="26,14,24,16">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="BTime" FontSize="42" FontWeight="Light" Foreground="White"/>
            <TextBlock x:Name="BDate" FontSize="13" Foreground="#99FFFFFF" Margin="2,-3,0,0"/>
          </StackPanel>
          <Border x:Name="BBattHost" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Grid>

      <!-- EXPANDED, with media -->
      <Grid x:Name="ExpMedia">
        <Grid Margin="20,14,20,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="2,0,0,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="MTime" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock x:Name="MDate" FontSize="13" Foreground="#80FFFFFF" Margin="8,0,0,0"/>
            </StackPanel>
            <Border x:Name="MBattHost" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="76" Height="76">
              <Border x:Name="MArt" CornerRadius="16" Background="#1FFFFFFF"/>
              <TextBlock x:Name="MArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="#80FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border CornerRadius="16" BorderThickness="1" BorderBrush="#1AFFFFFF"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="MTitle" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="MArtist" FontSize="13" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="-9,4,0,0">
                <Button x:Name="BtnPrev" Style="{StaticResource IconButton}" Content="&#xE892;"/>
                <Button x:Name="BtnPlay" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="20" Width="44" Height="44" Margin="4,0"/>
                <Button x:Name="BtnNext" Style="{StaticResource IconButton}" Content="&#xE893;"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2" Margin="8,12,8,0" Height="4">
            <Border CornerRadius="2" Background="#26FFFFFF"/>
            <Border x:Name="MProgress" CornerRadius="2" Background="#E6FFFFFF" HorizontalAlignment="Left" Width="0"/>
          </Grid>
        </Grid>
      </Grid>

      <!-- TOAST: notifications, battery, now playing -->
      <Grid x:Name="Toast">
        <Grid Margin="12,12,20,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="44" Height="44" VerticalAlignment="Center">
            <Border x:Name="TIcon" CornerRadius="12" Background="#1FFFFFFF"/>
            <TextBlock x:Name="TGlyph" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TApp" FontSize="11" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TTitle" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TBody" FontSize="12.5" Foreground="#B3FFFFFF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Canvas>

    <!-- rim light: brighter top-left and bottom-right like refracted glass edges -->
    <Border x:Name="Rim" BorderThickness="1" IsHitTestVisible="False">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#70FFFFFF" Offset="0"/>
          <GradientStop Color="#18FFFFFF" Offset="0.4"/>
          <GradientStop Color="#08FFFFFF" Offset="0.6"/>
          <GradientStop Color="#40FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
    </Border>
  </Grid>
</Grid>
